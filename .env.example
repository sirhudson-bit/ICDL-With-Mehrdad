# ─────────────────────────────────────────────────────────────
# ICDL With Mehrdad — environment configuration
# Copy to `.env` and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local development (zero-config, default in .env):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — also change the datasource provider in
# prisma/schema.prisma from "sqlite" to "postgresql", then run
# `npm run db:migrate`:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/icdl?schema=public"

# ── Authentication ──────────────────────────────────────────
# 32+ byte random string used to sign session cookies.
# Generate with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Session lifetime in days
SESSION_MAX_AGE_DAYS="30"

# Mark the session cookie `Secure`. Left unset, this is derived from
# NEXT_PUBLIC_SITE_URL: https origins get a Secure cookie, http origins do not.
# A production build served over plain HTTP with a Secure cookie cannot keep
# anyone signed in, so override only if you know your setup.
# COOKIE_SECURE="true"

# Public site origin, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Public site metadata ────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="ICDL With Mehrdad"

# ── AI chatbot (optional) ───────────────────────────────────
# The chatbot runs with a built-in offline "knowledge" provider when these
# are empty, so the platform is fully functional without any API key.
# The same values can be overridden at runtime from the admin panel
# (Admin → Settings → Chatbot), which is the recommended approach.
AI_PROVIDER="auto"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="1024"

# ── Behaviour ───────────────────────────────────────────────
# Allow visitors to create their own accounts (overridable in the admin panel)
ALLOW_REGISTRATION="true"
